# 2. RUN TIME CALCULATION ENGINE
# ========================================== #

def run_metascience_engine(age, weight, height, bf, sex, activity, goal, diet_pref, food_budget, workout_loc, insulin, sodium, celiac, lactose, nuts):
    try:
        age = float(age)
        weight = float(weight)
        height = float(height)
        bf = float(bf)
    except ValueError:
        return "[ERROR] Invalid biometric input coordinates.", None

    # Extended Biometric Calculations
    lbm = weight * (1.0 - (bf / 100.0))
    bmr = 370.0 + (21.6 * lbm)
    bsa = math.sqrt((height * weight) / 3600.0)

    # Advanced Water Requirements (Liters/day)
    base_water = weight * 0.033
    water_allowance = base_water + (1.2 if activity != "Sedentary (1.2)" else 0.0)

    # Custom Sodium Limit estimation (mg/day)
    sodium_limit = 1500 if sodium else 2300

    act_map = {
        "Sedentary (1.2)": 1.2,
        "Lightly Active (1.375)": 1.375,
        "Moderately Active (1.55)": 1.55,
        "Very Active (1.725)": 1.725,
        "Elite Athlete (1.9)": 1.9
    }
    activity_multiplier = act_map.get(activity, 1.55)
    tdee = bmr * activity_multiplier

    # Pathway Target calculation
    target_calories = tdee
    protein_g, fats_g, carbs_g = 0.0, 0.0, 0.0

    if goal == "Fat Loss Deficit":
        target_calories = tdee * 0.8
        protein_g = 2.4 * lbm
        fats_g = (target_calories * 0.25) / 9.0
        remaining_cals = target_calories - (protein_g * 4.0) - (fats_g * 9.0)
        carbs_g = max(0.0, remaining_cals / 4.0)
    elif goal == "Lean Muscle Hypertrophy":
        target_calories = tdee * 1.1
        protein_g = 2.0 * weight
        fats_g = (target_calories * 0.3) / 9.0
        remaining_cals = target_calories - (protein_g * 4.0) - (fats_g * 9.0)
        carbs_g = max(0.0, remaining_cals / 4.0)
    else:
        target_calories = tdee
        protein_g = (target_calories * 0.4) / 4.0
        fats_g = (target_calories * 0.3) / 9.0
        carbs_g = (target_calories * 0.3) / 4.0

    allergies = []
    if celiac: allergies.append("gluten")
    if lactose: allergies.append("dairy")
    if nuts: allergies.append("nuts")

    # Pie & Electrolyte Double Plot Generation
    tot_g = max(1.0, protein_g + carbs_g + fats_g)
    pct_p = (protein_g / tot_g) * 100
    pct_c = (carbs_g / tot_g) * 100
    pct_f = (fats_g / tot_g) * 100

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(11, 4.5), facecolor='#1E293B')
    ax1.set_facecolor('#1E293B')
    ax2.set_facecolor('#1E293B')

    # Pie Chart
    labels = [f'Protein\n({int(pct_p)}%)', f'Carbs\n({int(pct_c)}%)', f'Fat\n({int(pct_f)}%)']
    ax1.pie([pct_p, pct_c, pct_f], labels=labels, autopct='%1.1f%%', startangle=90,
           colors=['#38BDF8', '#34D399', '#F59E0B'], textprops=dict(color='#F1F5F9', weight='bold', fontsize=9),
           wedgeprops=dict(width=0.4, edgecolor='#1E293B', linewidth=2))
    ax1.set_title("TARGET MACROS RATIOS", color='#38BDF8', fontsize=10, fontweight='bold')

    # Bar Chart
    bars = ['Water (L)', 'Sodium (100mg)', 'BMR (100kCal)']
    values = [water_allowance, sodium_limit / 100.0, bmr / 100.0]
    ax2.bar(bars, values, color=['#38BDF8', '#F43F5E', '#10B981'], width=0.4)
    ax2.tick_params(colors='#F1F5F9', labelsize=9)
    ax2.set_title("BIOMETRIC TARGET BASELINES", color='#38BDF8', fontsize=10, fontweight='bold')
    for spine in ax2.spines.values():
        spine.set_color('#334155')

    # Filter Foods
    filtered_foods = []
    for v in DIET_DICTIONARY.values():
        if any(al in v["allergens"] for al in allergies):
            continue

        if diet_pref == "Vegan":
            if v["category"] == "Lean Proteins" or "dairy" in v["allergens"]:
                continue
        elif diet_pref == "Vegetarian":
            if v["category"] == "Lean Proteins" and "dairy" not in v["allergens"]:
                continue

        if food_budget != "All Tiers":
            if v["budget_tier"].lower() != food_budget.lower():
                continue

        filtered_foods.append(v)

    proteins_list = [f for f in filtered_foods if f["category"] in ["Lean Proteins", "Plant Proteins"]]
    carbs_list = [f for f in filtered_foods if f["category"] == "Complex Carbohydrates"]
    greens_list = [f for f in filtered_foods if f["category"] == "Fibrous Micro-Dense Greens"]
    fats_list = [f for f in filtered_foods if f["category"] == "Essential Lipids"]

    p_src = proteins_list[0] if proteins_list else {"name": "Hemp Protein Base", "calories_per_100g": 400, "protein_g": 50, "carbs_g": 12, "fat_g": 11}
    c_src = carbs_list[0] if carbs_list else {"name": "Steamed White Rice", "calories_per_100g": 130, "protein_g": 2, "carbs_g": 28, "fat_g": 0}
    g_src = greens_list[0] if greens_list else {"name": "Steamed Broccoli", "calories_per_100g": 35, "protein_g": 3, "carbs_g": 7, "fat_g": 0}
    f_src = fats_list[0] if fats_list else {"name": "Extra Virgin Olive Oil", "calories_per_100g": 884, "protein_g": 0, "carbs_g": 0, "fat_g": 100}

    meal_scale = 1.0 / 3.0
    p_weight = max(10, int(((protein_g * meal_scale) / max(0.1, p_src["protein_g"])) * 100))
    c_weight = max(10, int(((carbs_g * meal_scale) / max(0.1, c_src["carbs_g"])) * 100))
    f_weight = max(5, int(((fats_g * meal_scale) / max(0.1, f_src["fat_g"])) * 100))

    report = []
    report.append("=" * 65)
    report.append("             QUANTUM METASCIENCE ULTIMATE EXTREME PLAN")
    report.append("=" * 65)
    report.append(f"DAILY TARGETS: {int(target_calories)} kCal | LBM: {lbm:.2f} kg | BSA: {bsa:.2f} m²")
    report.append(f"DIETARY PATTERN: {diet_pref} ({food_budget}) | Target: P: {int(protein_g)}g | C: {int(carbs_g)}g | F: {int(fats_g)}g")
    report.append(f"DAILY WATER THRESHOLD: {water_allowance:.2f} Liters | SODIUM BUDGET: {sodium_limit} mg\n")

    for meal in ["BREAKFAST PROTOCOL", "LUNCH PROTOCOL", "DINNER PROTOCOL"]:
        report.append(f"[+] {meal}")
        report.append(f"   - {p_weight}g of {p_src['name']} (Protein Base)")
        report.append(f"   - {c_weight}g of {c_src['name']} (Complex Carbohydrates)")
        report.append(f"   - 100g of {g_src['name']} (Micronutrient Dense Greens)")
        report.append(f"   - {f_weight}g of {f_src['name']} (Lipid System)")
        meal_c = (p_weight*p_src['calories_per_100g'] + c_weight*c_src['calories_per_100g'] + 100*g_src['calories_per_100g'] + f_weight*f_src['calories_per_100g'])/100
        report.append(f"   * Projected Meal Energy: ~{int(meal_c)} kCal\n")

    joint_limit_profile = "high" if age < 50 else "low"
    report.append("=" * 65)
    report.append(f"         3-DAY BIOMECHANICAL STRENGTH & CONDITIONING ({workout_loc.upper()})")
    report.append("=" * 65)

    workout_splits = [
        ("DAY 1 - ANTERIOR KINETIC CHAIN (PUSH)", ["Horizontal Push", "Vertical Push", "Core Stability"]),
        ("DAY 2 - POSTERIOR KINETIC CHAIN (PULL)", ["Horizontal Pull", "Vertical Pull", "High-Intensity Conditioning"]),
        ("DAY 3 - LOWER EXTENSION & COMPRESSION (LEGS)", ["Quad-Dominant Lower", "Posterior Chain Lower", "Core Stability"])
    ]

    for day_title, movement_types in workout_splits:
        report.append(f"\n{day_title}")
        for m_type in movement_types:
            candidates = [ex for ex in EXERCISE_DICTIONARY.get(m_type, []) if ex["env"].lower() == workout_loc.lower()]
            chosen = None
            for cand in candidates:
                if joint_limit_profile == "low":
                    if cand["joint_loading_profile"] in ["low", "medium"]:
                        chosen = cand
                        break
                else:
                    if cand["joint_loading_profile"] == "high":
                        chosen = cand
                        break
            if not chosen and candidates: chosen = candidates[0]
            if chosen:
                reps_desc = "3 Sets x 12 Reps"
                if chosen["mechanical_type"] == "compound":
                    reps_desc = "4 Sets x 6 Reps (Strength Load)" if age < 50 else "3 Sets x 10 Reps"
                report.append(f"   -> [{m_type}] {chosen['name']}")
                report.append(f"      Load Profile: {chosen['joint_loading_profile'].upper()} | MET: {chosen['average_met_value']} | {reps_desc}")

    return "\n".join(report), fig

